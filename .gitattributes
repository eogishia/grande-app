# Windows와 맥을 오가는 저장소다. 줄바꿈을 저장소 안에서는 LF로 통일하고
# 작업 디렉터리에서는 각 OS에 맞게 풀어준다. 이게 없으면 한쪽에서 파일을
# 저장만 해도 전체 줄이 바뀐 것으로 잡혀 diff를 읽을 수 없게 된다.
* text=auto eol=lf

# 바이너리 — 절대 변환하지 않는다 (변환되면 파일이 깨진다)
*.woff2 binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jks   binary
*.jar   binary
*.apk   binary
*.aab   binary

# 맥·리눅스에서 실행되는 스크립트는 반드시 LF여야 한다
gradlew text eol=lf

# 윈도우 배치 파일은 CRLF여야 한다
*.bat text eol=crlf
