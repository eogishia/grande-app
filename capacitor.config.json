{
  "appId": "com.eogishia.grande",
  "appName": "Grande",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_grande",
      "iconColor": "#A98053"
    },
    "StatusBar": {
      "backgroundColor": "#F8F6F1",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "autoHideDelay": 600,
      "backgroundColor": "#F8F6F1",
      "showSpinner": false
    }
  }
}